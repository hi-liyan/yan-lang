module examples.errors

import yan.platform.console

enum ConfigError {
  MissingPort
  InvalidPort(value: string)
}

fn parse_port(value: Option<string>) -> Result<int, ConfigError> {
  let text = match value {
    Some(text) => text
    None => return Err(ConfigError.MissingPort)
  }

  match text.to_int() {
    Ok(port) => Ok(port)
    Err(_) => Err(ConfigError.InvalidPort(text))
  }
}

fn main() -> Result<int, ConfigError> {
  let port = parse_port(None)?
  console.println(port)

  Ok(0)
}
